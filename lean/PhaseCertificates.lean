lemma phaseLower_compact (j : Fin 7) : CompactPhaseCertificate j (phaseLower j) :=
  (phase_certificate_iff_compact j (phaseLower j)).mp (phaseLower_certificate j)

lemma phaseLower_le_inf (j : Fin 7) {p : ℕ} (hp : p ∈ selectedPrimes j) :
    phaseLower j p ≤ primePhaseInf j p :=
  phase_certificate_le_inf j (phaseLower j) (phaseLower_certificate j) hp

@[blueprint "varlamov-certified-prime-lifting"
  (title := "Varlamov, Lemma 7.4: the certified retained-prime lower bound")
  (statement := /-- The actual prime contribution exceeds the concrete
  certified prime budget throughout the band parameter domain. No phase
  or numerical certificate remains as an assumption. -/)
  (uses := ["varlamov-certified-phase-minima", "varlamov-prime-lifting"])]
theorem prime_powers_certified_lower_bound (j : Fin 7) {η h σ t : ℝ}
    (hη : 0 < η) (hηmax : η ≤ etaMax j) (hh : hMin j ≤ h) (hσ : σ ≤ sigmaMax j) :
    η * 10 * ((MarginExpression.data j).prime : ℝ) ≤ ∑' n : ℕ, primeContribution j σ h η t n := by
  apply le_trans (mul_le_mul_of_nonneg_left (primeLower_numeric j) (show 0 ≤ η * 10 by positivity))
  exact prime_powers_lower_bound j (phaseLower j) (phaseLower_certificate j) hη hηmax hh hσ

#print axioms prime_powers_certified_lower_bound
#print axioms phaseLower_certificate
end Varlamov
