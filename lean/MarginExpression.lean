def unitLeft : List ℚ := [10, 0, (-803357971194757140 / 8116714872719329), (1949476490131772700 / 8116714872719329), (4739689932378327360 / 8116714872719329), (-27224670632527090800 / 8116714872719329), 0, (130600736306600716800 / 8116714872719329), 0, (-336963558590417203200 / 8116714872719329)]
def moments : List ℚ := [(175596741259483951979985291149 / 100000000000000000000000000000), (243240518289988050924641347757 / 1000000000000000000000000000000), (15836974681604726897325045401 / 1000000000000000000000000000000), (-40207008479722749883307593 / 23437500000000000000000000000), (-5917375769239928142341911153 / 8000000000000000000000000000000), (-17075639736905201533889709481 / 120000000000000000000000000000000), (-229087830112625176153351841 / 11250000000000000000000000000000), (-12191126834496877252268476553 / 5040000000000000000000000000000000), (-10071096939222755556222929413 / 40320000000000000000000000000000000)]
def d : ℚ := (52698243 / 50000000)
def a1 : ℚ := (579010044340076601089576 / 333333333333509945567445)

def q (r : ℚ) : Expr := .const r
def add (a b : Expr) : Expr := .add a b
def mul (a b : Expr) : Expr := .mul a b
def sub (a b : Expr) : Expr := .add a (.neg b)
def div (a b : Expr) : Expr := mul a (.inv b)

def sumRange : ℕ → (ℕ → Expr) → Expr
  | 0, _ => q 0
  | n + 1, f => add (sumRange n f) (f n)

def rationalWInv (invz : Expr) : Expr :=
  mul (q d) (unitLeft.foldr (fun c acc => mul (add (q c) acc) (div invz (q d))) (q 0))

def inverseOne (μ η : Expr) (m : ℕ) : Expr :=
  div η (sub (q ((m + 1 : ℕ) : ℚ)) (mul (add (mul (q ((2*m+1 : ℕ) : ℚ)) μ) (q 1)) η))
def inverseTwo (μ η : Expr) (m : ℕ) : Expr :=
  div η (sub (q (m : ℚ)) (mul (sub (mul (q ((2*m+1 : ℕ) : ℚ)) μ) (q 1)) η))
def inverseThree (μ η : Expr) (m : ℕ) : Expr :=
  div η (sub (q (m : ℚ)) (mul (mul (q ((2*m+1 : ℕ) : ℚ)) μ) η))

def expression (j : Fin 7) : Expr :=
  let μ := Expr.var 0
  let η := Expr.var 1
  let A := Expr.var 2
  let v := sub μ (q 1)
  let dat := data j
  let small := moments.foldr (fun c acc => add (q c) (mul v acc)) (q 0)
  let large1 := sumRange dat.coeffs.length (fun m =>
    mul (q (a1 * dat.coeffs.getD m 0)) (rationalWInv (inverseOne μ η m)))
  let large2 := sumRange (dat.coeffs.length - 1) (fun n =>
    let m := n + 1
    mul (q (dat.coeffs.getD m 0)) (sub
      (mul (q a1) (rationalWInv (inverseTwo μ η m)))
      (rationalWInv (inverseThree μ η m))))
  sub (add (add (add small large1) large2)
    (mul (q (10*(dat.gamma+dat.prime)-1/10000000000)) η))
    (add (add (mul (q 13) (mul η (mul η η))) (q (1/10000000+1/1000000000000+1/100000000000000000)))
      (mul (q dat.q) A))

def environment (μ η A : ℝ) : ℕ → ℝ :=
  fun i => if i = 0 then μ else if i = 1 then η else if i = 2 then A else 0

noncomputable def value (j : Fin 7) (μ η A : ℝ) : ℝ :=
  Expr.eval (environment μ η A) (expression j)

def options : ADOptions :=
  { backend := .dyadic, taylorDepth := 20, dyadicPrecision := -100 }

def fullBox (j : Fin 7) : List IntervalRat :=
  [⟨9/10, 1, by norm_num⟩,
   ⟨1/(6*([45, 60, 70, 77, 80, 82, (8232067 / 100000)] : List ℚ).getD j.val 1),
     ([(180759 / 25000000), (115403 / 25000000), (34621 / 10000000), (296751 / 100000000), (134887 / 50000000), (129829 / 50000000), (10133 / 4000000)] : List ℚ).getD j.val 1, by
       fin_cases j <;> norm_num⟩,
   ⟨1/6, 50000/240703, by norm_num⟩]

def checkRange (j : Fin 7) (b : List IntervalRat) (idx : ℕ) (lo hi : ℚ) : Bool :=
  match evalWithDerivative (expression j) b idx options with
  | .error _ => false
  | .ok out => decide (lo ≤ out.derivative.lo ∧ out.derivative.hi ≤ hi)


