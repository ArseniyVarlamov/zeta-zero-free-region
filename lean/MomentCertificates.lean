lemma moment_from_primitives (n : ℕ) (p r q : ℝ[X])
    (hp : ∀ u : ℝ, p.eval u = u ^ n * Kernel.piece u)
    (hr : r.derivative = p) (hq : q.derivative + q = p) :
    moment n = Trigonometric.a 1 * (r.eval Kernel.d - r.eval 0) -
      (Real.exp Kernel.d * q.eval Kernel.d - q.eval 0) := by
  have hiP : IntervalIntegrable (fun u : ℝ => p.eval u) volume 0 Kernel.d :=
    p.continuous.intervalIntegrable _ _
  have hiE : IntervalIntegrable (fun u : ℝ => Real.exp u * p.eval u) volume 0 Kernel.d :=
    (Real.continuous_exp.mul p.continuous).intervalIntegrable _ _
  have hdr (u : ℝ) : HasDerivAt (fun x : ℝ => r.eval x) (p.eval u) u := by
    rw [← hr]
    exact r.hasDerivAt u
  have hdq (u : ℝ) : HasDerivAt (fun x : ℝ => Real.exp x * q.eval x) (Real.exp u * p.eval u) u := by
    have h := (Real.hasDerivAt_exp u).mul (q.hasDerivAt u)
    have he := congrArg (fun v : ℝ[X] => v.eval u) hq
    simp only [Polynomial.eval_add] at he
    convert h using 1
    rw [← he]
    ring
  have hri := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun u _ => hdr u) hiP
  have hqi := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun u _ => hdq u) hiE
  simp only [Real.exp_zero, one_mul] at hqi
  calc
    moment n = ∫ u in (0 : ℝ)..Kernel.d, Trigonometric.a 1 * p.eval u - Real.exp u * p.eval u := by
      apply intervalIntegral.integral_congr
      intro u _
      dsimp only
      rw [hp]
      ring
    _ = Trigonometric.a 1 * (∫ u in (0 : ℝ)..Kernel.d, p.eval u) -
        (∫ u in (0 : ℝ)..Kernel.d, Real.exp u * p.eval u) := by
      rw [intervalIntegral.integral_sub (hiP.const_mul _) hiE, intervalIntegral.integral_const_mul]
    _ = _ := by rw [hri, hqi]

