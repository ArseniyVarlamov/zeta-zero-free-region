/-!
# C_8a, R=4.81406, in the pinned PNT+ conventions

`c8a_zero_free_region` and `c8a_nonvanishing` prove the full closed region
under eight explicitly named published inputs. Both local finite certificate
obligations are discharged. `c8a_classical_zero_free` uses the existing PNT+
predicate. The auxiliary theorem below isolates the earlier PT/Y-only tails.
-/

namespace Varlamov
open Real

@[blueprint "varlamov-partial-nonvanishing"
  (title := "C_8a: the PT/Y-only nonvanishing corollary")
  (statement := /-- Under the published PT and Yang inputs, the proposed
  closed zero-free region holds for absolute height at least two outside
  the log-height window $(28.7296,82.32067)$. The full target in that window
  remains unproved in this partial formalization. -/)
  (uses := ["varlamov-zero-free-tails"])]
theorem c8a_partial_zero_free_region (hPT : PlattTrudgianInput) (hY : YangInput)
    {σ t : ℝ} (ht : 2 ≤ |t|) (hσ : 1 - 1 / ((4.81406 : ℝ) * log |t|) ≤ σ)
    (hwindow : log |t| ≤ 28.7296 ∨ 82.32067 ≤ log |t|) :
    riemannZeta ((σ : ℂ) + (t : ℂ) * Complex.I) ≠ 0 := by
  apply zero_free_outside_window hPT hY ht
  · simpa only [R_decimal] using hσ
  · exact hwindow

