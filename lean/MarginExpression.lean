  | 2 => ⟨[1, (-999959140973 / 1000000000000), (998687184651 / 1000000000000), (-985023741291 / 1000000000000), (228310039519 / 250000000000), (-702460268613 / 1000000000000), (342182468893 / 1000000000000), 0, (-4102513387 / 31250000000), (82013165569 / 1000000000000), (-1739634547 / 100000000000)], (777183 / 500000), (2283939 / 10000000), (87207322135427707711216520132885281 / 10000000000005298367023350000000000)⟩
