set_option maxHeartbeats 3000000 in
-- Several closed interval certificates and their exact rational transports
-- are checked together in this finite seven-band declaration.
lemma primeLower_numeric (j : Fin 7) :
    ((MarginExpression.data j).prime : ℝ) ≤ primeLowerBudget j (phaseLower j) := by
  fin_cases j <;> norm_num [MarginExpression.data, primeLowerBudget,
    selectedPrimes, phaseLower, phaseLowerQ] <;> interval_decide (trust := kernel) <;> norm_num [div_eq_mul_inv] <;> ring

#print axioms primeLower_numeric
end Varlamov
