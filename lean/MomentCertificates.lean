@[blueprint "varlamov-moment-enclosures"
  (title := "Varlamov, C11: exact moment integrals and enclosures")
  (statement := /-- All nine actual moments are enclosed in rational intervals
  of width $10^{-40}$, hence radius below $10^{-25}$. Polynomial primitives
  and a common Taylor-certified enclosure of exp(d) are checked in Lean. -/)
  (uses := ["varlamov-small-arguments", "varlamov-exact-transform"])]
theorem moment_bounds (n : Fin 9) : momentLower n ≤ moment n ∧ moment n ≤ momentUpper n := by
  have hlo := exp_d_bounds.1
  have hhi := exp_d_bounds.2
  norm_num [expDLow, expDHigh] at hlo hhi
  fin_cases n
  · rw [moment_exact_0]
    norm_num [momentLower, momentUpper]
    constructor <;> nlinarith
  · rw [moment_exact_1]
    norm_num [momentLower, momentUpper]
    constructor <;> nlinarith
  · rw [moment_exact_2]
    norm_num [momentLower, momentUpper]
    constructor <;> nlinarith
