  | 4 => ⟨[1, (-999981121591 / 1000000000000), (499662519843 / 500000000000), (-991531939227 / 1000000000000), (94640583039 / 100000000000), (-399813125131 / 500000000000), (516325105649 / 1000000000000), (-38827672481 / 200000000000), 0, (32774736667 / 1000000000000), (-9551506543 / 1000000000000)], (777539 / 500000), (1141429 / 5000000), (43603528505196002760991767634216199 / 5000000000002649183511675000000000)⟩
